{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "custom.regex"
  ],
  "dependencyDashboard": {
    "enabled": false
  },
  "automerge": true,
  "automergeType": "branch",
  "ignoreTests": true,
  "platformAutomerge": false,
  "rebaseWhen": "behind-base-branch",
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps",
  "packageRules": [
    {
      "description": "Temporary: AgentChatKit 0.12.1 rebuilds every bubble in a host that modifies the chat theme in the environment (Agent Pager fb_3cde3642c7513c88). Remove this rule with 0.12.2.",
      "matchPackageNames": [
        "jai/agentchatkit"
      ],
      "allowedVersions": "<0.12.1"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Jai's kits, pinned in both lockfiles; Package.swift and app/project.yml keep their from: ranges",
      "managerFilePatterns": [
        "/^Package\\.resolved$/",
        "/^app/Package\\.resolved$/"
      ],
      "matchStrings": [
        "\"location\"\\s*:\\s*\"https://github\\.com/(?<depName>jai/(?:durable-networking|agentchatkit|feedbackkit))\"\\s*,\\s*\"state\"\\s*:\\s*\\{\\s*\"revision\"\\s*:\\s*\"(?<currentDigest>[a-f0-9]{40})\"\\s*,\\s*\"version\"\\s*:\\s*\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "regex:^v(?<major>[0-9]+)[.](?<minor>[0-9]+)[.](?<patch>[0-9]+)$",
      "currentValueTemplate": "v{{{currentValue}}}",
      "autoReplaceStringTemplate": "{{{replace '\"[0-9]+[.][0-9]+[.][0-9]+\"' (toJSON (replace '^v' '' newValue)) (replace currentDigest newDigest replaceString)}}}"
    }
  ]
}
