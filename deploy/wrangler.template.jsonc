// A self-hosted PRHub Worker (worker/). setup.sh renders this into wrangler.jsonc beside it (gitignored), filling
// each placeholder; deploy with `npx wrangler@4 deploy --config deploy/wrangler.jsonc`.
// Contract: docs/api.md. An empty var is unset: the feature it serves is off.
{
  "name": "__WORKER_NAME__",
  "account_id": "__CLOUDFLARE_ACCOUNT_ID__",
  "main": "../worker/src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  // Every minute: compare with GitHub, read what changed, push when due.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    // Empty: the login is read from GITHUB_TOKEN.
    "GITHUB_LOGIN": "",
    // The owners PRHub filters to by default, comma-separated; empty shows every owner.
    "GITHUB_ORGS": "__GITHUB_ORGS__",
    // Push through Jai's relay to PRHub (com.jaigovindani.prreview). Empty: no push; the app syncs when opened.
    "PUSH_RELAY_URL": "__PUSH_RELAY_URL__",
    // Optional review SLA, e.g. "7", "9-18", "1,2,3,4,5" for UTC+7, 09:00-18:00, Monday to Friday. Empty: off.
    "REVIEW_SLA_UTC_OFFSET_HOURS": "__REVIEW_SLA_UTC_OFFSET_HOURS__",
    "REVIEW_SLA_HOURS": "__REVIEW_SLA_HOURS__",
    "REVIEW_SLA_WEEKDAYS": "__REVIEW_SLA_WEEKDAYS__",
    // Optional rewrite guide, "owner/repo@ref" and comma-separated paths. Empty: the built-in guide.
    "GUIDE_REPO": "",
    "GUIDE_FILES": "",
    // Optional webhook App (AGENTS.md, "Faster updates"): the org that owns it (empty: your account) and its name.
    "GITHUB_APP_OWNER": "",
    "GITHUB_APP_NAME": "",
    // Ask AI: what `npm run ask-agent` prints (AGENTS.md, step 7), passed to setup.sh. Empty: off.
    "ASK_AGENT_ID": "__ASK_AGENT_ID__",
    "ASK_ENVIRONMENT_ID": "__ASK_ENVIRONMENT_ID__",
    "ASK_VAULT_ID": "__ASK_VAULT_ID__",
    "ASK_CREDENTIAL_ID": "__ASK_CREDENTIAL_ID__"
  },
  "durable_objects": {
    "bindings": [
      { "name": "PR_INDEX", "class_name": "PrIndex" },
      { "name": "AI_JOBS", "class_name": "AiJobs" }
    ]
  },
  "migrations": [
    { "tag": "pr-index-v1", "new_sqlite_classes": ["PrIndex"] },
    { "tag": "ai-jobs-v1", "new_sqlite_classes": ["AiJobs"] }
  ],
  "r2_buckets": [{ "binding": "DIFFS", "bucket_name": "__R2_BUCKET__" }]
}
