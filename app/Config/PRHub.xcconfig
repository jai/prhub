// PRHub's build options, read into Info.plist (project.yml) and the entitlements. app/README.md lists them.

// The hosted Worker's host: Sign in with GitHub, its HTTPS callback and the webcredentials associated domain. A custom
// domain is this one line, with the GitHub App's callback URL and the Worker's route moved to match.
PRHUB_HOSTED_HOST = prhub.jai-f89.workers.dev

// Which ways in onboarding offers. A paired self-hosted Worker keeps working with PRHUB_SELF_HOSTED off; only new
// pairings and setup links are refused.
PRHUB_SIGN_IN_GITHUB = YES
PRHUB_SELF_HOSTED = NO
PRHUB_SAMPLES = YES

// Anonymous usage analytics (AGENTS.md, "Analytics"): the PostHog project's public client key and its host. An empty key
// sends nothing, so a fork reports nowhere until it names its own project. Debug builds never send.
PRHUB_ANALYTICS_KEY = phc_uRJQdyPp6YgzXqvDGdtY4r4dZWdxeeqaSQhZzDs7HwyW
PRHUB_ANALYTICS_HOST = eu.i.posthog.com

// The app group the PR mirror lives in: the app and its Notification Service Extension (PRHubNotifications) share it,
// so an alert's PR is on the phone before the tap. A fork names its own.
PRHUB_APP_GROUP = group.com.jaigovindani.prreview
