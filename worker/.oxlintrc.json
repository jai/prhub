{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "node"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["dist/**", "dist-hosted/**"],
  "rules": {
    "typescript/no-base-to-string": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/unbound-method": "off",
    "typescript/await-thenable": "off",
    "typescript/no-unsafe-unary-minus": "off",
    "typescript/require-array-sort-compare": "off"
  },
  "overrides": [
    {
      "files": ["test/**", "tests/**"],
      "rules": {
        "typescript/unbound-method": "off",
        "typescript/no-floating-promises": "off",
        "no-unsafe-optional-chaining": "off",
        "no-constant-binary-expression": "off",
        "unicorn/no-useless-spread": "off"
      }
    },
    {
      "files": ["test/unit/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "node:fs",
                "message": "Unit tests touch no disk: put the test in test/integration/node."
              },
              {
                "name": "node:fs/promises",
                "message": "Unit tests touch no disk: put the test in test/integration/node."
              },
              {
                "name": "node:child_process",
                "message": "Unit tests start no processes."
              },
              {
                "name": "node:sqlite",
                "message": "SQL tests live in test/integration/node."
              }
            ],
            "patterns": [
              {
                "regex": "^cloudflare:",
                "message": "The Worker runtime is test/integration/runtime only."
              },
              {
                "group": ["**/support/memory-sql*"],
                "message": "SQL tests live in test/integration/node."
              }
            ]
          }
        ]
      }
    }
  ]
}
